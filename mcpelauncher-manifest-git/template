# Template file for 'mcpelauncher-manifest-git'
homepage="https://minecraft-linux.github.io/"
license="GPL-3.0"
maintainer="juligar <julianisgaes@gmail.com>"
pkgname=mcpelauncher-manifest-git
revision=1
short_desc="Bedrock edition Minecraft launcher"
version=1.5.5
hostmakedepends="git cmake clang ninja curl Vulkan-Headers wayland-protocols qt5-quickcontrols"
makedepends="openssl-devel hidapi-devel ibus-devel jack-devel fribidi-devel MesaLib-devel pipewire-devel sndio-devel vulkan-loader-devel wayland-devel qt5-devel qt5-webengine-devel qt5-webchannel-devel qt5-declarative-devel qt5-svg-devel qt5-quickcontrols2-devel qt5-location-devel qt5-tools-devel libdecor libXScrnSaver"
ignore_elf_files="/usr/share/mcpelauncher/lib/x86_64/libsqliteX.so"

do_fetch() {
	git clone --depth 1 --recursive https://github.com/minecraft-linux/mcpelauncher-manifest.git ${wrksrc}
}

do_configure() {
	mkdir build
	cd build
	CC=clang CXX=clang++ cmake .. -Wno-dev -DCMAKE_BUILD_TYPE=Release -DJNI_USE_JNIVM=ON -DGAMEWINDOW_SYSTEM=SDL3 -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_POLICY_VERSION_MINIMUM=3.5
}

do_build() {
	cd build
	make -j$(getconf _NPROCESSORS_ONLN) 
}

do_install() {
	cd build
	make DESTDIR=${DESTDIR}/ install
	rm -r ${DESTDIR}/usr/share/mcpelauncher/lib/x86
	rm -r ${DESTDIR}/usr/share/mcpelauncher/lib/armeabi-v7a
	rm -r ${DESTDIR}/usr/share/mcpelauncher/lib/arm64-v8a
}
