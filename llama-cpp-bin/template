	ln -s /usr/lib/llama-cpp-bin/llama-perplexity ${DESTDIR}/usr/bin/
	ln -s /usr/lib/llama-cpp-bin/llama-quantize ${DESTDIR}/usr/bin/
	ln -s /usr/lib/llama-cpp-bin/llama-qwen2vl-cli ${DESTDIR}/usr/bin/
	ln -s /usr/lib/llama-cpp-bin/llama-results ${DESTDIR}/usr/bin/
	ln -s /usr/lib/llama-cpp-bin/llama-server ${DESTDIR}/usr/bin/
