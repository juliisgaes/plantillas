	ln -s /usr/lib/llama-cpp-bin/llama-debug-template-parser ${DESTDIR}/usr/bin/
	ln -s /usr/lib/llama-cpp-bin/llama-fit-params ${DESTDIR}/usr/bin/
	ln -s /usr/lib/llama-cpp-bin/llama-gemma3-cli ${DESTDIR}/usr/bin/
	ln -s /usr/lib/llama-cpp-bin/llama-gguf-split ${DESTDIR}/usr/bin/
	ln -s /usr/lib/llama-cpp-bin/llama-imatrix ${DESTDIR}/usr/bin/
	ln -s /usr/lib/llama-cpp-bin/llama-llava-cli ${DESTDIR}/usr/bin/
	ln -s /usr/lib/llama-cpp-bin/llama-minicpmv-cli ${DESTDIR}/usr/bin/
	ln -s /usr/lib/llama-cpp-bin/llama-mtmd-cli ${DESTDIR}/usr/bin/
