do_install() {
	vmkdir usr/lib/basilisk-bin/
	vextract -C ${DESTDIR}/usr/lib/basilisk-bin/ basilisk-20251009122226.linux-x86_64-gtk3.tar.xz
	vmkdir usr/bin/
	ln -s /usr/lib/basilisk-bin/basilisk ${DESTDIR}/usr/bin/
}
